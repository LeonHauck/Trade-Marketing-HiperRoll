# Protege a pasta data/ de acesso direto pelo navegador
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
</IfModule>

# O arquivo de usuário e senha nunca é servido pelo navegador
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

# Fallback: bloqueia acesso a arquivos .json diretamente
<FilesMatch "\.json$">
    Order allow,deny
    Deny from all
</FilesMatch>
